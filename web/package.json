{
  "name": "woca-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config vite.config.demo.ts",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.13",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.9",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "shiki": "^4.4.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@iconify-json/vscode-icons": "^1.2.73",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  }
}
