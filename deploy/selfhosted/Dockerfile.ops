# woca-ops: the tenant ops console facade — the opsui SPA plus a reverse
# proxy onto woca-server's management API (pageless). Build context:
# repository root (the SPA dist must be pre-built into internal/ee/opsui/spa
# — see ee/opsconsole-web).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /woca-ops ./cmd/woca-ops

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /woca-ops /usr/local/bin/woca-ops
ENTRYPOINT ["woca-ops"]
