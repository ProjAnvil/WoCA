# woca-worker: the execution role (claims runs from the shared queue).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /woca-worker ./cmd/woca-worker

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /woca-worker /usr/local/bin/woca-worker
ENTRYPOINT ["woca-worker"]
