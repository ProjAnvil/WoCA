# woca-enterprise full deployment environment
WOCA_PG_PASSWORD=woca-enterprise-dev
WOCA_PG_REPL_PASSWORD=woca-enterprise-dev
LADYM_PG_PASSWORD=ladym-enterprise-dev
LADYM_API_PASSWORD=ladym-enterprise-dev
# CJK segmentation dictionary baked into the ladyM images (build arg of
# Dockerfile.ladym-dict; the pinned files may also be dropped into
# deploy/selfhosted/dict/ for air-gapped builds)
LADYM_DICT_VARIANT=zh
# Host ports (gateway is the only publisher)
ENT_BUSINESS_PORT=8080
ENT_SKILL_PORT=9082
ENT_DISCOVERY_PORT=9083
ENT_LADYM_CONSOLE_PORT=9084

# ── console sign-in (optional) ────────────────────────────────────────
# Set BOTH to require a username/password login on the core consoles —
# the tenant ops console (:9091, tenants & keys / enrollment / audit)
# and the woca-config console (:9086, settings domains). Leave unset for
# open consoles (dev default).
#WOCA_CONSOLE_USER=admin
#WOCA_CONSOLE_PASSWORD=change-me

# ── Langfuse (LLM tracing, full stack obs segment) ────────────────────
# Required by docker-compose.full.yml (the dev profile defaults these to
# fixed dev values). ENCRYPTION_KEY: `openssl rand -hex 32`.
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
LANGFUSE_PG_PASSWORD=langfuse-dev
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse-dev
LANGFUSE_REDIS_AUTH=langfuse-redis-dev
LANGFUSE_MINIO_ROOT_PASSWORD=langfuse-minio-dev
# Optional: the bootstrap seeds org/project/admin user and pins the project
# API keys (defaults pk-lf-woca-local / sk-lf-woca-local, sign-in
# admin@woca.local / woca-langfuse-admin). Overriding the key pair means
# regenerating the OTLP auth header too:
#   printf 'pk:sk' | base64   →   LANGFUSE_OTLP_AUTH=Basic <output>
#LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-woca-local
#LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-woca-local
#LANGFUSE_OTLP_AUTH=Basic cGstbGYtd29jYS1sb2NhbDpzay1sZi13b2NhLWxvY2Fs
# Host ports: the Langfuse UI (:3000) and the browser-facing MinIO (:9090)
# publish on all interfaces for ops access — accessing from another
# machine also means setting LANGFUSE_NEXTAUTH_URL=http://<host>:3000.
#ENT_LANGFUSE_PORT=3000
#ENT_LANGFUSE_MINIO_PORT=9090
#LANGFUSE_NEXTAUTH_URL=http://your-host:3000

# ── edge dev group (docker-compose.edge-bridge.yml) ──────────────────
# One-time enrollment token from the tenant ops console (bridge 注册 →
# issue). The apikey-posture bridge cannot serve its web-config page
# before enrollment, so first boot goes through the env (v1.7 §6.5 ①).
#EDGE_ENROLL_TOKEN=
