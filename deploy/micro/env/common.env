# Shared assembly for every role — sourced first; each role's <role>.env
# can override anything below. Uncomment and edit per deployment.

# The shared settings database (postgres DSN; the single source of truth
# for settings, run queue, and tenancy).
#WOCA_DB=postgres://woca:woca@10.0.0.10:5432/woca?sslmode=disable

# The nacos registry — required (fail-closed) by every full-stack role.
#WOCA_NACOS_URL=http://10.0.0.11:8848/nacos

# Per-process log level (debug | info | warn | error).
WOCA_LOG_LEVEL=info
