# woca-server: the business API + console management authority.
# Business listener bind (behind the enterprise gateway):
WOCA_ADDR=:8080
# Service-plane gateway listener (entrygw registry + console API) — bind
# on the internal network only; the public entry is woca-edge:
#WOCA_GW_ADDR=:9090
# Queue dispatch (runs execute on woca-worker):
#WOCA_RUN_DISPATCH=queue
#WOCA_RUNS_OFF_HOST=true
