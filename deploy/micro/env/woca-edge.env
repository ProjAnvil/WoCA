# woca-edge: the stateless public entry (terminates bridges' tunnels,
# forwards the machine channel). Plain HTTP on a public bind is refused;
# loopback/dev stacks opt in with WOCA_EDGE_DEV_HTTP=1.
WOCA_EDGE_ADDR=:443
#WOCA_TLS_CERT=/etc/woca/edge.crt
#WOCA_TLS_KEY=/etc/woca/edge.key
# Private-plane targets (plain URLs or nacos:// references):
#WOCA_SERVICE_URL=http://woca-server:8080
#WOCA_CONFIGSVC_URL=http://woca-config:8086
