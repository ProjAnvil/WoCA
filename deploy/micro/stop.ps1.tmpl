# stop.ps1 — stop the @ROLE@ service started by start.ps1 (Windows).
#
# Generated by `make @ROLE@` for GOOS=windows builds. Order of
# responsibility: the pid file first; when the pid file is missing or its
# process is gone, fall back to searching by the binary name
# (Get-Process -Name), so a wiped pid file never leaves an orphan.
$ErrorActionPreference = 'SilentlyContinue'
$dir = Split-Path -Parent $MyInvocation.MyCommand.Path
Set-Location $dir

$service = '@ROLE@'
$pidFile = Join-Path $dir "$service.pid"

$targets = @()
if (Test-Path $pidFile) {
    $old = Get-Content $pidFile
    $p = Get-Process -Id $old -ErrorAction SilentlyContinue
    if ($p) {
        $targets += $p
    } else {
        Write-Host "$service pid file stale or pid gone; searching by name"
    }
    Remove-Item $pidFile -ErrorAction SilentlyContinue
}
if (-not $targets) {
    # Process name = binary base name without the .exe extension.
    $targets = Get-Process -Name $service -ErrorAction SilentlyContinue
}
if (-not $targets) {
    Write-Host "$service not running"
    exit 0
}
foreach ($p in $targets) {
    # Windows console processes have no SIGTERM contract; Stop-Process is
    # the supported termination path.
    Stop-Process -Id $p.Id
    Write-Host "$service stopped (pid $($p.Id))"
}
