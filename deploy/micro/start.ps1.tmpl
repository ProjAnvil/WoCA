# start.ps1 — run the @ROLE@ service binary in the background (Windows).
#
# Generated by `make @ROLE@` for GOOS=windows builds: the package carries
# the .ps1 pair INSTEAD of the .sh pair. The role name is baked in, so
# operators run this file with no arguments. An optional .\service.env
# (KEY=value lines) is loaded into the process environment — values
# already present in the environment win.
$ErrorActionPreference = 'Stop'
$dir = Split-Path -Parent $MyInvocation.MyCommand.Path
Set-Location $dir

$service = '@ROLE@'
$bin = Join-Path $dir "$service.exe"
$pidFile = Join-Path $dir "$service.pid"
$logFile = Join-Path $dir "$service.log"
$logErr = Join-Path $dir "$service.err.log"

if (Test-Path $pidFile) {
    $old = Get-Content $pidFile -ErrorAction SilentlyContinue
    if ($old -and (Get-Process -Id $old -ErrorAction SilentlyContinue)) {
        Write-Host "$service already running (pid $old)"
        exit 0
    }
    Remove-Item $pidFile -ErrorAction SilentlyContinue
}
if (-not (Test-Path $bin)) {
    Write-Error "$service binary not found: $bin"
}

$envFile = Join-Path $dir 'service.env'
if (Test-Path $envFile) {
    Get-Content $envFile | ForEach-Object {
        $line = $_.Trim()
        if ($line -and -not $line.StartsWith('#') -and $line.Contains('=')) {
            $k, $v = $line.Split('=', 2)
            if (-not [Environment]::GetEnvironmentVariable($k)) {
                [Environment]::SetEnvironmentVariable($k, $v)
            }
        }
    }
}

$p = Start-Process -FilePath $bin -WorkingDirectory $dir `
    -RedirectStandardOutput $logFile -RedirectStandardError $logErr `
    -PassThru -WindowStyle Hidden
$p.Id | Out-File -FilePath $pidFile -Encoding ascii
Start-Sleep -Seconds 1
if ($p.HasExited) {
    Write-Error "$service start failed (exited immediately); see $logErr"
}
Write-Host "$service started in background (pid $($p.Id), log: $logFile)"
