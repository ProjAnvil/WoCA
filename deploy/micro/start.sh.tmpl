#!/bin/sh
# start.sh — run the @ROLE@ service binary in the background.
#
# Generated by `make @ROLE@`: the role name is baked in, so operators run
# this file with no arguments. POSIX sh — works on macOS, Linux, and
# Alpine/BusyBox containers. An optional ./service.env (KEY=value lines)
# next to this script is sourced before launch — values already present
# in the environment win. Arguments after the mode flags are passed to
# the binary.
#
# WOCA_SVC_MODE=foreground (set by the container image): become the
# service instead of backgrounding it, so the supervisor's signals
# (docker stop, compose) reach the process directly — the graceful
# shutdown path.
set -eu
cd "$(dirname "$0")"

SERVICE="@ROLE@"
BIN="$PWD/$SERVICE"
PID_FILE="$PWD/$SERVICE.pid"
LOG_FILE="$PWD/$SERVICE.log"

alive() {
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # cmdline check: a recycled pid belonging to another process must not
    # read as "already running".
    ps -ww -p "$pid" -o args= 2>/dev/null | grep -q "$BIN"
}

if alive; then
    echo "$SERVICE: already running (pid $(cat "$PID_FILE"))"
    exit 0
fi
rm -f "$PID_FILE"
if [ ! -x "$BIN" ]; then
    echo "$SERVICE: binary not found next to this script ($BIN)" >&2
    exit 1
fi
if [ -f "$PWD/service.env" ]; then
    # set -a: plain KEY=value lines become the child environment
    # (environment values already set win, so containers override by env).
    set -a
    . "$PWD/service.env"
    set +a
fi
if [ "${WOCA_SVC_MODE:-}" = "foreground" ]; then
    exec "$BIN" "$@"
fi
nohup "$BIN" "$@" >>"$LOG_FILE" 2>&1 &
pid=$!
echo "$pid" >"$PID_FILE"
sleep 1
if ! kill -0 "$pid" 2>/dev/null; then
    echo "$SERVICE: start failed (process exited immediately); tail of $LOG_FILE:" >&2
    tail -n 5 "$LOG_FILE" >&2 || true
    rm -f "$PID_FILE"
    exit 1
fi
echo "$SERVICE: started in background (pid $pid, log: $LOG_FILE)"
