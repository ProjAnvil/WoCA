# Full deployment gateway — mirrors deploy/selfhosted/gateway/nginx-full.conf
# with cross-node upstreams (the app/memory/mgmt nodes' ENI addresses).
# The Grafana :8085 block from the original is dropped until the
# observability overlay lands.

upstream woca_schedulers {
    least_conn;
%{ for upstream in server_upstreams ~}
    server ${upstream};
%{ endfor ~}
}

# SSE-friendly settings for all proxied locations
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
server {
    listen 80;  # business entry (NLB :80)
    location = /metrics { return 404; }
    location / {
        proxy_pass http://woca_schedulers;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_buffering off;          # SSE
        proxy_read_timeout 3600s;     # long runs
        proxy_send_timeout 3600s;
    }
}

server {
    listen 8082;  # skill-svc management SPA (NLB :9082)
    location / {
        proxy_pass http://woca_schedulers/skills/;
        proxy_set_header Host $host;
    }
    location /api/skills/ {
        proxy_pass http://woca_schedulers/api/skills/;
        proxy_set_header Host $host;
    }
}

server {
    listen 8083;  # component discovery & configuration (NLB :9083)
    location /health {
        proxy_pass http://woca_schedulers/api/health;
    }
    location /woca/status {
        proxy_pass http://woca_schedulers/api/stats;
    }
    location /ladym/health {
        proxy_pass http://${ladym_host}:8080/api/stats;
    }
    location /ladym/stats {
        proxy_pass http://${ladym_host}:8080/api/stats;
    }
}

# Config console (NLB :9086) — the settings management plane on the mgmt
# node (published host port 8080).
upstream woca_config {
    server ${config_host}:8080;
}
server {
    listen 8086;
    location = /metrics { return 404; }
    location / {
        proxy_pass http://woca_config;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Langfuse ops UI (NLB :3000) — reverse-proxied to the infra node's
# langfuse-web (LLM tracing; the roles reach it only through the
# woca-collector bridge, ops reach the UI through the DMZ entry).
# NEXTAUTH sign-in callbacks need the externally visible origin: set
# LANGFUSE_NEXTAUTH_URL=http://<nlb-host>:3000 on the infra node.
server {
    listen 3000;
    location / {
        proxy_pass http://${infra_host}:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
