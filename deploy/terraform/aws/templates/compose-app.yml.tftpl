# App node compose — mirrors docker-compose.full.yml woca-scheduler /
# woca-worker / woca-tenant (one of each per node; scale by node count).
# The node's ENIs carry the data/mq/memory/mgmt legs, so every address
# below is reachable in-zone.
name: woca-private-app

services:
  woca-scheduler:
    image: ${images["woca-scheduler"]}
    container_name: woca-scheduler
    # The role images are baked from the make <role> packages; their
    # start.sh entrypoint passes this through to the binary.
    command: ["serve", "--addr", ":8080"]
    restart: unless-stopped
    ports:
      - "8080:8080" # business entry (gateway nginx upstream)
      - "8090:8090" # service-plane listener (WOCA_GW_ADDR)
    environment:
      WOCA_DB: "${nacos_url}/DEFAULT_GROUP/woca-db.dsn"
      WOCA_NACOS_URL: "${nacos_url}"
      WOCA_AUTH: apikey
      WOCA_RUN_DISPATCH: "queue"
      WOCA_RUNS_OFF_HOST: "true"
      WOCA_SESSION_DIR: /var/lib/woca-data/sessions
      WOCA_HOME: /var/lib/woca/home
      WOCA_GW_ADDR: ":8090"
      # Telemetry (§12.2 env layer): the trace bridge address resolves from
      # the registry at startup like the DSN — LLM/session spans land in
      # Langfuse via the infra node's woca-collector.
      WOCA_SERVICE_NAME: woca-scheduler
      WOCA_OTEL_EXPORTER_OTLP_ENDPOINT: "${nacos_url}/DEFAULT_GROUP/woca-obs.otlp"
      WOCA_CONSOLE_USER: $${WOCA_CONSOLE_USER:-}
      WOCA_CONSOLE_PASSWORD: $${WOCA_CONSOLE_PASSWORD:-}
    volumes:
      - /var/lib/woca-data/sessions:/var/lib/woca/sessions
      - /var/lib/woca/home:/var/lib/woca/home
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 12
      start_period: 15s

  woca-worker:
    image: ${images["woca-worker"]}
    container_name: woca-worker
    restart: unless-stopped
    ports:
      - "9091:9091" # OBS_ADDR probe
    environment:
      WOCA_DB: "${nacos_url}/DEFAULT_GROUP/woca-db.dsn"
      WOCA_NACOS_URL: "${nacos_url}"
      WOCA_OBS_ADDR: ":9091"
      # Same registry-resolved trace bridge as woca-scheduler — the worker is
      # where runs execute, so this is where LLM/session spans originate.
      WOCA_SERVICE_NAME: woca-worker
      WOCA_OTEL_EXPORTER_OTLP_ENDPOINT: "${nacos_url}/DEFAULT_GROUP/woca-obs.otlp"
      WOCA_SESSION_DIR: /var/lib/woca-data/sessions
      WOCA_HOME: /var/lib/woca/home
    volumes:
      - /var/lib/woca-data/sessions:/var/lib/woca/sessions
      - /var/lib/woca/home:/var/lib/woca/home
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:9091/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 12
      start_period: 10s

  # Admin toolbox (`docker exec` tenant/key commands). Same legs as the
  # compose original (edge+pg+mq) via this node's ENIs.
  woca-tenant:
    image: ${images["woca-tenant"]}
    container_name: woca-tenant
    entrypoint: ["sh", "-c", "echo 'woca-tenant: use docker exec to run commands' && sleep infinity"]
    restart: unless-stopped
    environment:
      WOCA_DB: "${nacos_url}/DEFAULT_GROUP/woca-db.dsn"
      WOCA_HOME: /var/lib/woca/home
    volumes:
      - /var/lib/woca/home:/var/lib/woca/home
