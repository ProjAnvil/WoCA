# Stack rendering: passwords, the shared .env, and each node's cloud-init
# (compose subset + node-specific files, hand-mirrored from
# deploy/selfhosted/docker-compose.full.yml — edit both sides together).

# URL-embedded passwords (DSNs) must stay URL-safe: letters + digits only.
resource "random_password" "woca_pg" {
  length  = 24
  special = false
}

resource "random_password" "woca_pg_repl" {
  length  = 24
  special = false
}

resource "random_password" "ladym_pg" {
  length  = 24
  special = false
}

resource "random_password" "console" {
  length = 16
}

locals {
  woca_pg_password      = var.woca_pg_password != "" ? var.woca_pg_password : random_password.woca_pg.result
  woca_pg_repl_password = var.woca_pg_repl_password != "" ? var.woca_pg_repl_password : random_password.woca_pg_repl.result
  ladym_pg_password     = var.ladym_pg_password != "" ? var.ladym_pg_password : random_password.ladym_pg.result
  console_password      = var.console_password != "" ? var.console_password : random_password.console.result

  nacos_url    = "http://${local.node_ips["infra"]}:8848"
  pg_host      = local.node_ips["data"]
  ladym_host   = local.node_ips["infra"]
  app_upstream = "http://${local.node_ips["app-1"]}:8090"
  server_upstreams = var.app_count == "2" ? [
    "${local.node_ips["app-1"]}:8080",
    "${local.node_ips["app-2"]}:8080",
  ] : ["${local.node_ips["app-1"]}:8080"]

  env_content = join("\n", [
    "# generated by terraform — do not edit on the node",
    "WOCA_PG_PASSWORD=${local.woca_pg_password}",
    "WOCA_PG_REPL_PASSWORD=${local.woca_pg_repl_password}",
    "LADYM_PG_PASSWORD=${local.ladym_pg_password}",
    "WOCA_CONSOLE_USER=${var.console_user}",
    "WOCA_CONSOLE_PASSWORD=${local.console_password}",
    "",
  ])

  # ── per-node file sets (paths → content) ───────────────────────────────
  nginx_conf = templatefile("${path.module}/templates/nginx-gateway.conf.tftpl", {
    server_upstreams = local.server_upstreams
    ladym_host       = local.ladym_host
    config_host      = local.node_ips["mgmt"]
  })

  compose_dmz = templatefile("${path.module}/templates/compose-dmz.yml.tftpl", {})
  compose_app = templatefile("${path.module}/templates/compose-app.yml.tftpl", {
    images    = local.images
    nacos_url = local.nacos_url
    registry  = var.registry
  })
  compose_data = templatefile("${path.module}/templates/compose-data.yml.tftpl", {})
  # The infra zone runs the merged platform substrate: NATS cluster +
  # ladyM (dict image) + nacos — nacos rides infra because nacosrt is a
  # hard startup gate for every business role.
  compose_infra = templatefile("${path.module}/templates/compose-infra.yml.tftpl", {
    images       = local.images
    pg_host      = local.pg_host
    app_upstream = local.app_upstream
  })
  compose_mgmt = templatefile("${path.module}/templates/compose-mgmt.yml.tftpl", {
    images    = local.images
    nacos_url = local.nacos_url
  })

  pg_init = {
    "01-roles-and-conventions.sql" = templatefile("${path.module}/templates/pg/01-roles-and-conventions.sql", {})
    "02-replication-role.sh"       = templatefile("${path.module}/templates/pg/02-replication-role.sh", {})
    "03-allow-replication.sh" = templatefile("${path.module}/templates/pg/03-allow-replication.sh.tftpl", {
      data_cidr = local.subnets["data"].cidr
    })
    "init-replica.sh" = templatefile("${path.module}/templates/pg/init-replica.sh", {})
  }

  node_files = {
    dmz = merge(
      { "docker-compose.yml" = local.compose_dmz },
      { "nginx/nginx-full.conf" = local.nginx_conf },
    )
    app-1 = { "docker-compose.yml" = local.compose_app }
    app-2 = { "docker-compose.yml" = local.compose_app }
    data = merge(
      { "docker-compose.yml" = local.compose_data },
      { for name, content in local.pg_init : "pg/${name}" => content },
    )
    infra = { "docker-compose.yml" = local.compose_infra }
    mgmt  = { "docker-compose.yml" = local.compose_mgmt }
  }

  # Nodes whose /var/lib/woca-data lives on the attached EBS volume
  # (ladym-pg lives on infra).
  volume_nodes = toset(concat(["data", "infra"], local.app_nodes))

  user_data = {
    for node in local.active_nodes :
    node => templatefile("${path.module}/templates/cloud-init.yaml.tftpl", {
      node       = node
      env        = local.env_content
      files      = local.node_files[node]
      mount_data = contains(local.volume_nodes, node)
    })
  }
}
