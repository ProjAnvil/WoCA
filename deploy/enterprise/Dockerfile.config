# woca-config: the standalone settings management plane (design §16).
# Build context: repository root (the SPA dist must be pre-built into
# internal/configsvc/spa — see configsvc-web).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /woca-config ./cmd/woca-config

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /woca-config /usr/local/bin/woca-config
ENTRYPOINT ["woca-config"]
CMD ["--addr", ":8080"]
