# woca-tenant: the tenant administration binary.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /woca-tenant ./cmd/woca-tenant

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /woca-tenant /usr/local/bin/woca-tenant
# v1: CLI-only; the HTTP admin surface arrives with the tenant console (§7.4).
# A tiny keep-alive loop so the container stays up for docker exec.
ENTRYPOINT ["sh", "-c", "echo 'woca-tenant: use docker exec to run commands' && sleep infinity"]
