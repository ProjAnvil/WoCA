# woca-enterprise development defaults.
#
# DEVELOPMENT-ONLY credentials: this file is committed so `docker compose up`
# works out of the box for a local dev loop. Change both passwords (and the
# ports, if you like) before pointing anything semi-serious at this stack.

# PostgreSQL (app user `woca`, database `woca`).
WOCA_PG_PASSWORD=woca-enterprise-dev
# Streaming-replication role (created by initdb/02-replication-role.sh).
WOCA_PG_REPL_PASSWORD=woca-enterprise-repl-dev

# Host ports published by the gateway (high ports; the container-side
# listeners are the fixed values in gateway/nginx.conf).
ENT_PG_WRITE_PORT=35432     # → pg-primary
ENT_PG_READ_PORT=35433      # → pg-replica (hot standby, read-only)
ENT_NATS_PORT=34222         # → NATS cluster (client protocol)
ENT_NATS_MONITOR_PORT=38222 # → NATS monitoring (varz / jsz / healthz)
