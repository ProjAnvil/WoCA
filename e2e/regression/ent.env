# Environment for the regression runner's enterprise dev stack
# (docker compose -f deploy/selfhosted/docker-compose.dev.yml --env-file THIS).
# Fixed values on purpose: the regression must be reproducible, never
# re-randomized between runs. DEV_ENROLL_TOKEN is injected through the
# process environment (it is minted by stage 04 from the ops console).
WOCA_PG_PASSWORD=woca-regression-pg
WOCA_PG_REPL_PASSWORD=woca-regression-pg
LADYM_PG_PASSWORD=ladym-regression-pg
LADYM_API_PASSWORD=ladym-regression-pg
LADYM_DICT_VARIANT=zh

# Console sign-in: the regression exercises the gated posture.
WOCA_CONSOLE_USER=reg-admin
WOCA_CONSOLE_PASSWORD=reg-console-pass

# Host ports — the compose defaults; the preflight stage checks they are
# free before the stack boots.
ENT_BUSINESS_PORT=8080
ENT_SKILL_PORT=9082
ENT_DISCOVERY_PORT=9083
ENT_CONFIG_PORT=9086
DEV_OPS_PORT=9091
ENT_EDGE_PORT=8453
DEV_BRIDGE_PORT=3490
